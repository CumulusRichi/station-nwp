{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "station-nwp",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node preparar_cloudflare.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [{
    "name": "LOGIN_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 20, "period": 60 }
  }]
}
